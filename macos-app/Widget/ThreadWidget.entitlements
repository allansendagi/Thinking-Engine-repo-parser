<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Widget extensions must be sandboxed. The only thing this one may do is read the small snapshot
  of recent ideas that the Thread app writes into the shared group container.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>RPU3YJFJK7.com.thread.mac</string>
    </array>
</dict>
</plist>
